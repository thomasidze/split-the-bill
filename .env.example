# Токен бота от @BotFather
BOT_TOKEN=
# Имя бота без @
BOT_USERNAME=
# Короткое имя Mini App, заданное в @BotFather
APP_SHORT_NAME=
# Публичный HTTPS-адрес приложения, без "/" на конце
APP_URL=
# Секрет для проверки вебхука Telegram
WEBHOOK_SECRET=
# Путь к файлу базы SQLite (необязательно)
DB_PATH=data/app.db
